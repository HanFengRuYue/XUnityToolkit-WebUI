<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XUnityToolkit_WebUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="XUnity Toolkit WebUI">
  <Grid x:Name="RootLayout" Background="#0B0B11">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid
        x:Name="NativeTitleBar"
        Height="32"
        Background="#0B0B11"
        Visibility="Collapsed" />

    <Grid x:Name="BrowserHost" Grid.Row="1" />

    <Grid x:Name="StartupOverlay" Grid.Row="1" Background="#0B0B11">
      <StackPanel
          Width="560"
          MaxWidth="560"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="14">
        <ProgressRing
            x:Name="LoadingRing"
            Width="42"
            Height="42"
            HorizontalAlignment="Center"
            IsActive="True" />
        <TextBlock
            x:Name="OverlayTitle"
            HorizontalAlignment="Center"
            FontFamily="Segoe UI"
            FontSize="22"
            Foreground="#E0E0E8"
            Text="XUnity Toolkit" />
        <TextBlock
            x:Name="OverlayMessage"
            HorizontalAlignment="Center"
            Foreground="#90909E"
            Text="正在启动本机服务…"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="OverlayDetail"
            MaxHeight="120"
            HorizontalAlignment="Center"
            Foreground="#A8A8B6"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <StackPanel
            x:Name="ErrorActions"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10"
            Visibility="Collapsed">
          <Button Content="重试" Click="Retry_Click" />
          <Button Content="在浏览器中打开" Click="OpenBrowser_Click" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
