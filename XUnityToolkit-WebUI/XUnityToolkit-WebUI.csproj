<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <VersionPrefix>5.0</VersionPrefix>
    <RootNamespace>XUnityToolkit_WebUI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <PublishTrimmed>false</PublishTrimmed>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SpaRoot>..\XUnityToolkit-Vue\</SpaRoot>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);MSB3277;NU1900</NoWarn>
    <Edition Condition="'$(Edition)' == ''">full</Edition>
  </PropertyGroup>

  <!-- Inject edition as assembly metadata for runtime detection -->
  <ItemGroup>
    <AssemblyMetadata Include="Edition" Value="$(Edition)" />
  </ItemGroup>

  <!-- Always build and embed the official Release endpoint so safety metadata cannot describe a missing DLL. -->
  <Target Name="BuildAndEmbedTranslatorEndpoint" BeforeTargets="AssignTargetPaths">
    <MSBuild
      Projects="..\TranslatorEndpoint\TranslatorEndpoint.csproj"
      Targets="Build"
      Properties="Configuration=Release"
      RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile;InformationalVersion;Version;VersionPrefix;VersionSuffix;AssemblyVersion;FileVersion;PackageVersion;SourceRevisionId;DebugType;DebugSymbols;Edition" />
    <ItemGroup>
      <EmbeddedResource Include="..\TranslatorEndpoint\bin\Release\net35\LLMTranslate.dll" LogicalName="LLMTranslate.dll" />
    </ItemGroup>
  </Target>

  <!-- Embed classdata.tpk for Unity asset type deserialization -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\classdata.tpk" LogicalName="classdata.tpk" />
    <EmbeddedResource Include="Resources\translator-endpoint-metadata.json" LogicalName="translator-endpoint-metadata.json" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.2" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="AssetsTools.NET.Cpp2IL" Version="3.0.4" />
    <PackageReference Include="AssetsTools.NET.MonoCecil" Version="3.0.4" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <PackageReference Include="AssetRipper.TextureDecoder" Version="2.6.2" />
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
    <PackageReference Include="IndexRange" Version="1.1.1" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="RectpackSharp" Version="1.2.0" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy TMP fonts to output directory during build -->
  <ItemGroup Condition="Exists('..\bundled\fonts')">
    <Content Include="..\bundled\fonts\**" CopyToOutputDirectory="PreserveNewest" Link="bundled\fonts\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- RuntimeFontLoader is built from pinned BepInEx archives by build.ps1 / CI. -->
  <ItemGroup Condition="Exists('..\bundled\runtime-font-loader')">
    <Content Include="..\bundled\runtime-font-loader\**" CopyToOutputDirectory="PreserveNewest" Link="bundled\runtime-font-loader\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Copy script tag presets to output directory during build -->
  <ItemGroup Condition="Exists('..\bundled\script-tag-presets.json')">
    <Content Include="..\bundled\script-tag-presets.json" CopyToOutputDirectory="PreserveNewest" Link="bundled\script-tag-presets.json" />
  </ItemGroup>

  <!-- Bundled plugin ZIPs and llama.cpp binaries are copied by build.ps1 after publish -->

  <!-- Build frontend before backend build (skip with -p:SkipFrontendBuild=true) -->
  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Message Importance="high" Text="Installing frontend dependencies..." />
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" />
    <Message Importance="high" Text="Building frontend..." />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <!-- Microsoft.NET.Sdk does not implicitly copy/publish wwwroot like Microsoft.NET.Sdk.Web did.
       Resolve the Vite output after BuildFrontend and replace stale hashed assets atomically per tree. -->
  <Target Name="CopyFrontendAssetsToBuildOutput" AfterTargets="Build" DependsOnTargets="BuildFrontend">
    <ItemGroup>
      <_FrontendAsset Include="wwwroot\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" />
    <Copy
      SourceFiles="@(_FrontendAsset)"
      DestinationFiles="@(_FrontendAsset->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CopyFrontendAssetsToPublishOutput" AfterTargets="Publish" DependsOnTargets="BuildFrontend">
    <ItemGroup>
      <_FrontendPublishAsset Include="wwwroot\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <Copy
      SourceFiles="@(_FrontendPublishAsset)"
      DestinationFiles="@(_FrontendPublishAsset->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- The modular WinUI package emits the application's compiled XAML and PRI into
       TargetDir, but Microsoft.NET.Sdk does not add those generated files to publish.
       A publish without them builds successfully and then fails in InitializeComponent. -->
  <Target Name="CopyWinUIResourcesToPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_WinUICompiledXaml Include="$(TargetDir)*.xbf" />
      <_WinUIAppResource Include="$(TargetDir)$(AssemblyName).pri" />
      <_WinUIPublishResource Include="@(_WinUICompiledXaml);@(_WinUIAppResource)" />
    </ItemGroup>
    <Error Condition="'@(_WinUICompiledXaml)' == ''" Text="WinUI compiled XAML files were not generated in $(TargetDir)." />
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI application resource index was not generated in $(TargetDir)." />
    <Copy
      SourceFiles="@(_WinUIPublishResource)"
      DestinationFiles="@(_WinUIPublishResource->'$(PublishDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
