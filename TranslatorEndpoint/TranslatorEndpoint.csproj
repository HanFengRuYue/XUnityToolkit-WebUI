<Project Sdk="Microsoft.NET.Sdk"
         TreatAsLocalProperty="InformationalVersion;Version;VersionPrefix;VersionSuffix;AssemblyVersion;FileVersion;DebugType;DebugSymbols">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>LLMTranslate</AssemblyName>
    <RootNamespace>LLMTranslate</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <OutputType>Library</OutputType>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Reference assemblies for dotnet build to target net35 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- XUnity DLLs are reference-only; do not copy to output -->
  <ItemGroup>
    <Reference Include="XUnity.AutoTranslator.Plugin.Core">
      <HintPath>libs\XUnity.AutoTranslator.Plugin.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="XUnity.Common">
      <HintPath>libs\XUnity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
